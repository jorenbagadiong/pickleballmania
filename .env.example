# Copy to `.env` (repo root) to change defaults. Real environment variables
# always win over this file. Restart the servers after editing.
#
# NOTE: choose which network interface to listen on with GAME_HOST on the
# command line (e.g. `GAME_HOST=100.101.102.103 yarn host`), not in this file —
# the yarn scripts set GAME_HOST themselves.

# Port of the multiplayer (Colyseus) server. The browser client derives the
# server address from the page's hostname plus this port.
GAME_SERVER_PORT=2567

# Full game-server URL override for the browser client. Leave empty for local
# play; intended for a future production deployment (e.g. https://game.example.com).
GAME_SERVER_URL=

# Optional: only pages served from these origins may join games
# (comma-separated, exact scheme://host:port). Empty = allow any page that can
# reach the server. Example:
# GAME_ALLOWED_ORIGINS=http://192.168.1.50:4173,http://100.101.102.103:4173
GAME_ALLOWED_ORIGINS=

# Extra hostnames the Vite dev/preview server will answer to (IP addresses,
# localhost and *.ts.net Tailscale names are already allowed). Comma-separated.
GAME_ALLOWED_HOSTS=

# Client ports (dev server and the production preview used by `yarn host`).
CLIENT_DEV_PORT=5173
CLIENT_PREVIEW_PORT=4173
